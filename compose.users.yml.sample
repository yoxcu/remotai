services:
  work-alice:
    image: agent-base:latest
    container_name: work-alice
    hostname: alice
    restart: unless-stopped
    stop_grace_period: 20s
    environment:
      AGENT_NAME: alice
      AGENT_HOST: agents.example.com
      AGENT_CLAUDE: '1'
      AGENT_CODEX: '1'
    ports:
    - 0.0.0.0:2201:22
    volumes:
    - alice-home:/home/dev
    - /srv/agents/alice/projects:/home/dev/projects
    - /srv/agents/alice/ssh:/run/portal-keys:ro
    - type: bind
      source: /home/alice/.ssh/authorized_keys
      target: /run/host-authorized-keys
      read_only: true
      bind:
        create_host_path: false
  work-ci:
    image: agent-base:latest
    container_name: work-ci
    hostname: ci
    restart: unless-stopped
    stop_grace_period: 20s
    environment:
      AGENT_NAME: ci
      AGENT_HOST: agents.example.com
      AGENT_CLAUDE: '0'
      AGENT_CODEX: '1'
    ports:
    - 0.0.0.0:2203:22
    volumes:
    - ci-home:/home/dev
    - /srv/agents/ci/projects:/home/dev/projects
    - /srv/agents/ci/ssh:/run/portal-keys:ro
volumes:
  alice-home:
    name: alice-home
  ci-home:
    name: ci-home
