services:
  work-alice:
    image: agent-base:latest
    container_name: work-alice
    hostname: alice
    restart: unless-stopped
    stop_grace_period: 20s
    environment:
      AGENT_NAME: alice
      AGENT_HOST: agents.example.com
      AGENT_CLAUDE: '1'
      AGENT_CODEX: '1'
    ports:
    - 0.0.0.0:2201:22
    volumes:
    - alice-home:/home/dev
    - /srv/agents/alice/projects:/home/dev/projects
    - type: bind
      source: /home/alice/.ssh/authorized_keys
      target: /run/host-authorized-keys
      read_only: true
      bind:
        create_host_path: false
  work-bob:
    image: agent-base:latest
    container_name: work-bob
    hostname: bob
    restart: unless-stopped
    stop_grace_period: 20s
    environment:
      AGENT_NAME: bob
      AGENT_HOST: agents.example.com
      AGENT_CLAUDE: '1'
      AGENT_CODEX: '0'
    ports:
    - 0.0.0.0:2202:22
    volumes:
    - bob-home:/home/dev
    - /srv/agents/bob/projects:/home/dev/projects
    - type: bind
      source: /home/bob/.ssh/authorized_keys
      target: /run/host-authorized-keys
      read_only: true
      bind:
        create_host_path: false
volumes:
  alice-home:
    name: alice-home
  bob-home:
    name: bob-home
