# syntax=docker/dockerfile:1
#
# agent-base — one image, one work container per person.
#
# Deliberately contains NO credentials and NO agent configuration. Everything
# personal (~/.claude, ~/.codex, ~/.ssh, shell rc) lives in the per-user named
# volume mounted at /home/dev, so `portal update` can throw this image away and
# rebuild it without touching a single login.
FROM ubuntu:24.04

ARG DEV_UID=1000
ARG DEV_GID=1000

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# ---------------------------------------------------------------------------
# 1. Base packages.
# ---------------------------------------------------------------------------
# Split from the third-party repos below so a key/repo change does not
# re-download the whole distro.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        locales \
        sudo \
        tini \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# 2. Third-party apt repos: NodeSource (Node 22 LTS) and GitHub CLI.
# ---------------------------------------------------------------------------
# Ubuntu 24.04's own `gh` is frozen at the release-time version, so use the
# upstream repo. Keys are dearmored to keyrings and pinned with signed-by
# rather than piping an installer script into a shell.
RUN curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /usr/share/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list

# ---------------------------------------------------------------------------
# 3. The toolchain itself.
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        nodejs \
        git \
        git-lfs \
        gh \
        tmux \
        openssh-server \
        jq \
        ripgrep \
        fd-find \
        less \
        vim \
        nano \
        rsync \
        unzip \
        build-essential \
        python3 \
        python3-pip \
        python3-venv \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && git lfs install --system \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# 4. The `dev` user.
# ---------------------------------------------------------------------------
# Ubuntu 24.04 ships a stock `ubuntu` account already sitting on UID/GID 1000,
# which collides with the usual host UID. Remove it before creating `dev`.
RUN userdel -r ubuntu 2>/dev/null || true; \
    groupdel ubuntu 2>/dev/null || true; \
    if getent group "${DEV_GID}" >/dev/null; then \
        groupmod -n dev "$(getent group "${DEV_GID}" | cut -d: -f1)"; \
    else \
        groupadd -g "${DEV_GID}" dev; \
    fi; \
    useradd -m -u "${DEV_UID}" -g "${DEV_GID}" -s /bin/bash dev; \
    echo 'dev ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/90-dev; \
    chmod 0440 /etc/sudoers.d/90-dev; \
    # '*' (no password will ever match) rather than passwd -l's '!': a locked
    # account can trip pam_unix's account phase on key-only logins. This is the
    # convention the Ubuntu cloud images use.
    usermod -p '*' dev

# ---------------------------------------------------------------------------
# 5. sshd.
# ---------------------------------------------------------------------------
# Two separate PATH mechanisms, because they cover different cases:
#
#   /etc/environment     -> applied by sshd through PAM. This is what covers
#                           `ssh host 'command'`, which bash runs NON-login and
#                           NON-interactive, reading neither /etc/profile nor
#                           ~/.bashrc. The Codex desktop app spawns
#                           `codex app-server` exactly this way.
#   /etc/profile.d/...   -> login shells (`ssh -t host`, `bash -lc`, tmux).
#
# claude is an npm global under the default /usr prefix (/usr/bin/claude) and
# codex is the standalone installer's symlink (/usr/local/bin/codex); both are
# on the default PATH regardless. The profile.d entries add the per-user
# prefixes that survive `portal update` in the home volume.
RUN rm -f /etc/ssh/ssh_host_*_key* \
    && mkdir -p /etc/ssh/authorized_keys.d /run/sshd \
    && sed -i 's/^\(session\s\+required\s\+pam_loginuid\.so\)/#\1/' /etc/pam.d/sshd \
    && printf '%s\n' \
        'PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"' \
        'LANG="en_US.UTF-8"' \
        > /etc/environment
COPY sshd_config /etc/ssh/sshd_config
COPY profile.d-agent.sh /etc/profile.d/10-agent.sh
RUN chmod 0644 /etc/ssh/sshd_config /etc/profile.d/10-agent.sh

# ---------------------------------------------------------------------------
# 6. Project toolchain hook — yours to edit.
# ---------------------------------------------------------------------------
# Sits above the npm layer on purpose: `portal update` busts only the layer
# below, so your toolchain stays cached across updates, while editing the hook
# costs one npm install.
COPY toolchain.hook.sh /usr/local/lib/toolchain.hook.sh
RUN chmod 0755 /usr/local/lib/toolchain.hook.sh && /usr/local/lib/toolchain.hook.sh

# ---------------------------------------------------------------------------
# 7. The agents.
# ---------------------------------------------------------------------------
# REFRESH is bumped by `portal update` to force a fresh pull of both CLIs. Both
# layers reference it, so both move together.
ARG REFRESH=0
RUN echo "refresh=${REFRESH}" \
    && npm install -g --no-fund --no-audit @anthropic-ai/claude-code \
    && npm cache clean --force \
    && claude --version

# Codex comes from the standalone installer rather than npm, and it is
# installed into an image path rather than into a home directory. Both of those
# are forced by `codex remote-control`:
#
#   * the whole `remote-control` / `app-server daemon` family refuses to run
#     unless a STANDALONE install exists at
#     $CODEX_HOME/packages/standalone/current/codex — "because the daemon starts
#     and updates app-server from that fixed path". The npm package does not
#     satisfy it. Nothing else here needs the standalone layout, so there is no
#     reason to carry both.
#   * $CODEX_HOME is ~/.codex, which is the per-user VOLUME. Installing there
#     would put ~350MB in every volume and let the daemon's own auto-updater
#     drift each container onto a different Codex behind `portal update`'s back.
#
# So it is installed once, here, read-only and root-owned; supervisor.sh points
# each user's ~/.codex/packages/standalone at it. The daemon is happy to run
# from a read-only tree — only the auto-updater wants to write, and version
# control belongs to `portal update`.
ENV CODEX_SHARED_STANDALONE=/opt/codex/packages/standalone
# Downloaded to a file rather than piped into `sh`: RUN uses /bin/sh with no
# pipefail, so `curl | sh` swallows a failed or truncated download and the build
# carries on. </dev/null for the same reason in reverse — with the script no
# longer occupying stdin, an unexpected prompt would hang the build instead of
# reading EOF. CODEX_HOME is set for this command only; baking it into the image
# would point every user's Codex at this read-only tree and break their logins.
RUN echo "refresh=${REFRESH}" \
    && curl -fsSL https://chatgpt.com/codex/install.sh -o /tmp/codex-install.sh \
    && env CODEX_HOME=/opt/codex \
           CODEX_INSTALL_DIR=/usr/local/bin \
           CODEX_NON_INTERACTIVE=true \
           sh /tmp/codex-install.sh </dev/null \
    && rm -f /tmp/codex-install.sh \
    && chmod -R a-w "${CODEX_SHARED_STANDALONE}" \
    && test -x "${CODEX_SHARED_STANDALONE}/current/bin/codex" \
    && codex --version

COPY supervisor.sh /usr/local/bin/supervisor.sh
RUN chmod 0755 /usr/local/bin/supervisor.sh

EXPOSE 22
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/supervisor.sh"]
