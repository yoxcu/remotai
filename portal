# commands
# ---------------------------------------------------------------------------

def ensure_image(cfg: dict) -> None:
    if image_exists():
        return
    info(f"{IMAGE} does not exist yet — building it")
    build_image(cfg, refresh=False)


def build_image(cfg: dict, refresh: bool) -> None:
    uid, gid = build_uid_gid(cfg)
    env = {k: v for k, v in os.environ.items() if k not in BANNED_ENV}
    env["DEV_UID"] = str(uid)
    env["DEV_GID"] = str(gid)
    # Busting REFRESH invalidates only the two agent layers, so claude (npm) and
    # codex (the standalone installer) come down fresh while the apt layers and
    # your toolchain hook stay cached.
    env["REFRESH"] = str(int(time.time())) if refresh else "0"
    info(f"building {IMAGE} (uid={uid} gid={gid}"
         + (f", REFRESH={env['REFRESH']}" if refresh else "") + ")")
    proc = subprocess.run(
        [docker_bin(), "compose", "-f", str(BASE_COMPOSE),
         "--profile", "build", "build", "agent-base"],
        env=env, check=False)
    if proc.returncode != 0:
        die("image build failed")


def cmd_add(args: argparse.Namespace) -> None:
    cfg = load_config(required=False)
    name = args.name
    if not NAME_RE.match(name):
        die(f"invalid name {name!r}: must start with a lowercase letter and "
            "contain only lowercase letters, digits and dashes (max 31 chars)")
    if any(u["name"] == name for u in cfg["users"]):
        die(f"user '{name}' already exists — use './portal rm {name}' first, "
            f"or edit {USERS_YAML.name}")

    extra: list[str] = []
    for raw in (args.key or []):
        extra.extend(parse_keys(raw))

    akeys = None
    if not args.no_host_keys:
        akeys = resolve_authorized_keys(name, args.host_user, args.authorized_keys)
        if akeys is None:
            who = args.host_user or name
            if not extra:
                die(f"no host account called {who!r} and no --key given.\n"
                    f"       Create the account, or pick a source:\n"
                    f"         ./portal add {name} --key ~/keys/{name}.pub\n"
                    f"         ./portal add {name} --host-user <existing-account>\n"
                    f"         ./portal add {name} --authorized-keys /path/to/file")
            warn(f"no host account called {who!r}; using only the "
                 f"{len(extra)} key(s) from --key")

    taken = {int(u["port"]) for u in cfg["users"]}
    if args.port:
        port = args.port
        if port in taken:
            die(f"port {port} is already taken")
    else:
        port = next((p for p in range(PORT_BASE, PORT_CEILING + 1) if p not in taken), None)
        if port is None:
            die(f"no free port in {PORT_BASE}..{PORT_CEILING}")

    claude = args.claude
    codex = args.codex
    if not claude and not codex:
        warn("neither --claude nor --codex given; creating an SSH-only container. "
             f"Edit {USERS_YAML.name} and run './portal update' to change that.")

    entry = {"name": name, "port": port, "claude": claude, "codex": codex}
    if codex and args.sandbox_mode:
        entry["sandbox_mode"] = args.sandbox_mode
        if args.sandbox_mode == "danger-full-access":
            warn("danger-full-access: Codex sessions from the phone get no inner "
                 "sandbox. On this host that is usually the honest setting — the "
                 "container is the boundary — but be sure you meant it.")
    elif args.sandbox_mode and not codex:
        warn("--sandbox-mode does nothing without --codex; ignoring it")
    if claude:
        entry["spawn"] = args.spawn
        entry["workdir"] = args.workdir
        mode = "bypassPermissions" if args.skip_permissions else args.permission_mode
        if mode:
            entry["permission_mode"] = mode
        if mode == "bypassPermissions":
            warn("bypassPermissions: this container's agent will run tools without "
                 "asking. The container is the only thing standing between it and "
                 "the host, and it has network access and passwordless sudo.")
        if args.spawn == "worktree" and args.workdir == DEFAULT_WORKDIR:
            warn(f"--spawn worktree needs {DEFAULT_WORKDIR} to be a git repository. "
                 "It is not, so the container will fall back to same-dir. Pass "
                 "--workdir /home/dev/projects/<repo> to get real worktree mode.")
    if akeys:
        entry["authorized_keys"] = akeys
    if extra:
        entry["extra_keys"] = extra
    cfg["users"].append(entry)
    cfg["users"].sort(key=lambda u: u["name"])
    save_config(cfg)
    info(f"added '{name}' to {USERS_YAML.name} (port {port}, "
         f"claude={claude}, codex={codex})")
    info(f"keys come from: {describe_key_sources(entry)}")

    render(cfg)
    ensure_image(cfg)
    compose(cfg, ["up", "-d", f"work-{name}"])

    host = agent_host(cfg)
    print()
    info(f"work-{name} is up. Next:")
    print(f"     1. check SSH:   ssh -p {port} dev@{host}")
    if claude or codex:
        print(f"     2. one-time logins: ./portal setup {name}")
    if codex:
        print(f"     3. send them docs/USER-CODEX.md (port {port})")
        print(f"        a phone pairs with: ./portal pair {name}")
    if claude:
        print("     4. send them docs/USER-CLAUDE.md")


def _step(n: int, total: int, title: str) -> None:
    print()
    print(_c("1;36", f"── step {n}/{total}: {title} " + "─" * max(0, 50 - len(title))))


def cmd_setup(args: argparse.Namespace) -> None:
    if not sys.stdin.isatty():
        die("`portal setup` is interactive and needs a TTY "
            "(both agents print a URL and wait for you to paste a code back)")
    cfg = load_config()
    user = find_user(cfg, args.name)
    name = user["name"]
    if container_state(name) != "running":
        die(f"work-{name} is not running (state: {container_state(name)}). "
            f"Try './portal update' first.")

    steps = []
    if user["claude"]:
        steps += ["claude auth login", "accept workspace trust", "enable remote control"]
    if user["codex"]:
        steps += ["codex login", "pair the Codex mobile app"]
    if not steps:
        die(f"user '{name}' has neither claude nor codex enabled in {USERS_YAML.name}")
    total = len(steps) + 1
    n = 0

    # Hold the supervised loop off while we drive the same directory by hand.
    exec_in(name, "touch /home/dev/.rc-paused")
    exec_in(name, "tmux kill-session -t rc 2>/dev/null || true")
    try:
        if user["claude"]:
            n += 1
            _step(n, total, "claude auth login")
            print("Sign in with the claude.ai account that should own this container's\n"
                  "sessions. Claude Code prints a URL; open it, approve, paste the code back.\n"
                  "This is the ONLY supported login for Remote Control — not `setup-token`,\n"
                  "not an API key.\n")
            exec_in(name, "cd /home/dev/projects && claude auth login", tty=True)
            if exec_in(name, "claude auth status").returncode != 0:
                die("still not signed in — rerun './portal setup %s'" % name)
            info("signed in")

            n += 1
            _step(n, total, "accept workspace trust for /home/dev/projects")
            print("Claude Code never persists trust for $HOME itself, which is why the\n"
                  "Remote Control server runs from /home/dev/projects. Accept the trust\n"
                  "prompt for that directory once, then leave the session (/exit).\n")
            input("press enter to start claude in /home/dev/projects … ")
            exec_in(name, "cd /home/dev/projects && claude", tty=True)

            n += 1
            _step(n, total, "enable remote control")
            print("Answer 'y' to \"Enable Remote Control?\". Once it says it is connected,\n"
                  "press Ctrl-C to come back here — the supervised loop takes over from\n"
                  "there and will restore these sessions on every restart.\n")
            input("press enter to start claude remote-control … ")
            exec_in(name, "cd /home/dev/projects && claude remote-control "
                          f"--name '{name}@{agent_host(cfg)}' --spawn worktree", tty=True)

        if user["codex"]:
            n += 1
            _step(n, total, "codex login")
            signed_in = codex_login(cfg, user)

            n += 1
            _step(n, total, "pair the Codex mobile app")
            if signed_in:
                codex_pair(cfg, user)
            else:
                warn(f"no Codex login yet, so there is nothing to pair with. "
                     f"Run './portal pair {name}' once that is sorted.")
    finally:
        exec_in(name, "rm -f /home/dev/.rc-paused")

    n += 1
    _step(n, total, "restart the container")
    compose(cfg, ["up", "-d", "--force-recreate", f"work-{name}"])
    # The Claude loop announces itself with a tmux session; the Codex daemon has
    # nothing to hold open, so its first poll is the thing to wait for.
    probe = ("tmux has-session -t rc" if user["claude"]
             else "codex app-server daemon version")
    info("waiting for the supervised loop to come up …")
    for _ in range(20):
        time.sleep(2)
        if exec_in(name, probe).returncode == 0:
            break
    print()
    _print_status_rows(cfg, [user], quick=False)
    print()
    if user["claude"]:
        print("Attach to the live Claude session any time with:")
        print(f"     ssh -p {user['port']} dev@{agent_host(cfg)} -t 'tmux attach -t rc'")
    if user["codex"]:
        print(f"Pair another phone any time with:  ./portal pair {name}")


CODEX_LOGIN_PORT = 1455


def codex_login(cfg: dict, user: dict) -> bool:
    """Walk through whichever Codex login flow this workspace still allows.

    Returns True if the container ends up signed in.

    `codex login` runs a local OAuth callback server on localhost:1455 and
    expects a browser on the same machine. In a container neither is true, so
    there are two ways in:

      1. Forward 1455 from the operator's machine INTO the container over SSH.
         The tunnel has to terminate in the container, not on the host, because
         the container has its own network namespace — which means SSH, not
         docker exec.
      2. `--device-auth`, which needs no tunnel but which some ChatGPT
         workspaces disable ("contact your workspace admin to enable device
         code authentication").
    """
    name = user["name"]
    port = user["port"]
    host = agent_host(cfg)

    print("Codex has no headless login of its own: `codex login` serves an OAuth\n"
          f"callback on localhost:{CODEX_LOGIN_PORT} and wants a browser there.\n")
    print("  1. SSH tunnel   — works even when device code is disabled (recommended)")
    print("  2. Device code  — no tunnel, but many workspaces block it")
    print("  3. Skip         — do it later\n")
    choice = (input("which? [1] ") or "1").strip()

    if choice == "2":
        exec_in(name, "cd /home/dev/projects && codex login --device-auth", tty=True)
    elif choice == "3":
        warn(f"skipped; rerun './portal setup {name}' when ready")
        return False
    else:
        print()
        print("On YOUR machine (not this server), in a second terminal:\n")
        print(_c("1", f"    ssh -L {CODEX_LOGIN_PORT}:localhost:{CODEX_LOGIN_PORT} "
                      f"-p {port} dev@{host}"))
        print()
        print("Then, inside that SSH session:\n")
        print(_c("1", "    codex login"))
        print()
        print("It prints a URL. Open it in your own browser. When it redirects to\n"
              f"localhost:{CODEX_LOGIN_PORT} the tunnel carries the callback back into the\n"
              "container, and the login lands in ~/.codex — which is on the persistent\n"
              "volume, so it survives every `portal update`.\n")
        input("press enter once that has finished … ")

    status = exec_in(name, "codex login status")
    if status.returncode == 0:
        info("codex signed in")
        return True

    warn("codex still reports no login:\n       "
         + (status.stdout or status.stderr).strip().replace("\n", "\n       "))
    print()
    print("If device code is disabled AND the tunnel is awkward, the last resort is\n"
          "to log in on your own machine and copy the credentials over:\n")
    print(_c("1", f"    ssh -p {port} dev@{host} 'mkdir -p ~/.codex'"))
    print(_c("1", f"    scp -P {port} ~/.codex/auth.json dev@{host}:~/.codex/auth.json"))
    print()
    print("That carries the refresh token, so it keeps working — but it ties this\n"
          "container to the same account as your laptop's Codex. Prefer the tunnel.")
    return False


# ---------------------------------------------------------------------------
# codex remote control (the mobile app)
# ---------------------------------------------------------------------------
# Enrollment lands a beat after the daemon does, and `pair` answers "remote
# control pairing is unavailable until enrollment completes" until it has.
CODEX_PAIR_TRIES = 6
CODEX_PAIR_WAIT = 3


def codex_rc_start(user: dict) -> tuple[str | None, str]:
    """Bring up the app-server daemon with remote control enabled.

    Idempotent — it reports `alreadyRunning` rather than starting a second one —
    and it re-enables remote control on a daemon that has it switched off, so it
    is the only command needed to get a container back on the air. Returns
    (status, raw output); status is None if it did not come up.

    It passes the same `-c sandbox_mode=` the supervisor does. If it did not,
    a `portal pair` that happened to find the daemon down would start one
    configured differently from every daemon the supervisor starts.
    """
    name = user["name"]
    cfg_arg = ""
    if user.get("sandbox_mode"):
        cfg_arg = f" -c 'sandbox_mode=\"{user['sandbox_mode']}\"'"
    res = exec_in(name, f"codex remote-control start{cfg_arg} --json 2>&1")
    out = (res.stdout or res.stderr or "").strip()
    # Usually the whole of stdout is the object. Scan for it anyway rather than
    # trusting that nothing ever prints a line above it.
    for text in [out] + [ln for ln in out.splitlines() if ln.startswith("{")]:
        try:
            return json.loads(text).get("status"), out
        except (ValueError, AttributeError):
            continue
    return None, out


def codex_pair(cfg: dict, user: dict) -> bool:
    """Print a short-lived pairing code for the Codex app on someone's phone."""
    name = user["name"]
    print("The daemon in this container enrolls with the ChatGPT account it is signed\n"
          "in as, and a phone signed into that same account can often just pick it up.\n"
          "This is the manual route, for when it does not.\n")

    status, out = codex_rc_start(user)
    if status is None:
        warn("`codex remote-control start` did not come up:\n       "
             + out.replace("\n", "\n       "))
        print(f"\nSort the login out first, then: ./portal pair {name}")
        return False
    info(f"app-server daemon up; remote control is {status}")

    out = ""
    for _ in range(CODEX_PAIR_TRIES):
        res = exec_in(name, "codex remote-control pair 2>&1")
        out = (res.stdout or res.stderr or "").strip()
        if out and not out.lower().startswith("error"):
            print()
            print(_c("1;32", out))
            print()
            print("On the phone: open Codex signed in with the SAME ChatGPT account and\n"
                  "add this computer with that code. It is short-lived — if it expires,\n"
                  f"./portal pair {name} prints a fresh one.\n")
            print(f"The device appears as {_c('1', name)} — Codex names it after the "
                  "container's\nhostname and takes no --name flag, so there is no "
                  f"'{name}@{agent_host(cfg)}'\nform the way Claude has.")
            return True
        time.sleep(CODEX_PAIR_WAIT)

    warn("no pairing code came back:\n       " + out.replace("\n", "\n       "))
    print(f"\nEnrollment can lag the login by a while. Check './portal status' — "
          f"DAEMON\nshould read 'up' — and the container's ~/codex.log, then try "
          f"./portal pair {name}\nagain.")
    return False


def cmd_pair(args: argparse.Namespace) -> None:
    cfg = load_config()
    user = find_user(cfg, args.name)
    name = user["name"]
    if not user["codex"]:
        die(f"user '{name}' has codex: false in {USERS_YAML.name} — there is no "
            f"Codex daemon to pair with. Set it, then './portal update'.")
    state = container_state(name)
    if state != "running":
        die(f"work-{name} is not running (state: {state}). "
            f"Try './portal update' first.")
    if exec_in(name, "codex login status").returncode != 0:
        die(f"work-{name} is not signed in to Codex — './portal setup {name}' first")
    if not codex_pair(cfg, user):
        sys.exit(1)


_MARK = "@@portal@@"


def _gather(name: str, probes: dict[str, str]) -> dict[str, tuple[int, str]]:
    """Run several read-only probes in ONE `docker exec`: {key: (rc, output)}.

    Every exec is a fresh login shell, which costs more than most probes do, so
    batching is what keeps `status <name>` quick. Output is merged stdout+stderr.
    """
    script = "".join(f"{{ {cmd}\n}} 2>&1; printf '\\n{_MARK} %s %s\\n' {key} $?\n"
                     for key, cmd in probes.items())
    out: dict[str, tuple[int, str]] = {}
    buf: list[str] = []
    for line in (exec_in(name, script).stdout or "").split("\n"):
        if line.startswith(_MARK + " "):
            _, key, rc = line.split(" ", 2)
            text = "\n".join(buf)
            out[key] = (int(rc), text[:-1] if text.endswith("\n") else text)
            buf = []
        else:
            buf.append(line)
    return {key: out.get(key, (-1, "")) for key in probes}


# The daemon's own bookkeeping. `daemon version` only asks whatever answers on
# the control socket, so "running" there does not mean the daemon still tracks
# that app-server — and when it does not, `remote-control start` refuses and
# nothing ever restarts it. A pid file naming a live process is what "tracked"
# means here.
_PIDFILE_SH = (
    'pidfile() { f="$HOME/.codex/app-server-daemon/$1.pid"; '
    '[ -e "$f" ] || { echo missing; return; }; '
    "p=$(grep -o '[0-9]\\+' \"$f\" | head -n1); "
    'if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then echo "alive $p"; '
    'else echo "dead ${p:-?}"; fi; }; ')

CODEX_DAEMON_PROBES = {
    # stderr dropped: these two are parsed as JSON, and a warning would break that.
    "daemon": "codex app-server daemon version 2>/dev/null",
    "settings": "cat ~/.codex/app-server-daemon/settings.json 2>/dev/null",
    "pidfile": _PIDFILE_SH + "pidfile app-server",
}


def _classify_daemon(probe: dict[str, tuple[int, str]]) -> str:
    """up / no-rc / orphan / down, from the CODEX_DAEMON_PROBES results."""
    try:
        running = json.loads(probe["daemon"][1].strip()).get("status") == "running"
    except (ValueError, TypeError, AttributeError):
        running = False
    if not running:
        return "down"
    if not probe["pidfile"][1].startswith("alive"):
        return "orphan"
    # A daemon can be up for the desktop app while remote control is off, and
    # then no phone can see it — worth telling those two apart.
    try:
        enabled = json.loads(probe["settings"][1].strip()).get("remoteControlEnabled")
    except (ValueError, TypeError, AttributeError):
        enabled = False
    return "up" if enabled else "no-rc"


def _codex_daemon(name: str) -> str:
    """Read-only view of the Codex app-server daemon.

    Deliberately not `remote-control start`: that would START a daemon as a side
    effect of being asked whether one is running, which is not what `status`
    should do. `daemon version` only talks to an existing control socket.
    """
    return _classify_daemon(_gather(name, CODEX_DAEMON_PROBES))


def _probe(user: dict, state: str, quick: bool) -> dict:
    """One row of `portal status`.

    Only the agents a user actually has are probed: every probe is a `docker
    exec` into a login shell, and asking a Claude-only container about its Codex
    daemon costs exactly as much as asking a real one.
    """
    name = user["name"]
    row = {"state": state, "claude": "-", "codex": "-", "rc": "-", "cx": "-",
           "last": "", "codex_last": ""}
    if not user["claude"]:
        row["claude"] = row["rc"] = "off"
    if not user["codex"]:
        row["codex"] = row["cx"] = "off"
    if quick or state != "running":
        return row

    if user["claude"]:
        # `claude auth status` exits non-zero when logged out and otherwise
        # prints JSON. Show authMethod rather than a bare "ok": an API-key login
        # reports itself as logged in but Remote Control will never work with it.
        res = exec_in(name, "claude auth status")
        if res.returncode != 0:
            row["claude"] = "NO LOGIN"
        else:
            try:
                row["claude"] = (json.loads(res.stdout).get("authMethod") or "ok")[:9]
            except (ValueError, TypeError):
                row["claude"] = "ok"
        row["rc"] = "up" if exec_in(name, "tmux has-session -t rc").returncode == 0 else "down"
        row["last"] = exec_in(name, "tail -n 1 /home/dev/rc.log 2>/dev/null").stdout.strip()[:88]

    if user["codex"]:
        row["codex"] = "ok" if exec_in(name, "codex login status").returncode == 0 else "NO LOGIN"
        row["cx"] = _codex_daemon(name)
        row["codex_last"] = exec_in(name, "tail -n 1 /home/dev/codex.log 2>/dev/null").stdout.strip()[:88]

    return row


def _print_status_rows(cfg: dict, users: list[dict], quick: bool) -> None:
    host = agent_host(cfg)
    # LOOP is the tmux session around `claude remote-control`; DAEMON is the
    # Codex app-server daemon that phones pair with.
    # SPAWN and PERMS are Claude's knobs, SANDBOX is Codex's. SANDBOX comes
    # last and is not padded, so the line is only as long as it has to be.
    hdr = (f"{'NAME':<14}{'PORT':<7}{'STATE':<11}{'CLAUDE':<10}{'LOOP':<9}"
           f"{'CODEX':<10}{'DAEMON':<9}{'SPAWN':<10}{'PERMS':<18}{'SANDBOX'}")
    print(_c("1", hdr))
    rows = []
    for user in users:
        name = user["name"]
        state = container_state(name)
        row = _probe(user, state, quick)
        rows.append((user, row))
        spawn = user.get("spawn", "same-dir") if user["claude"] else "-"
        perms = (user.get("permission_mode") or "default") if user["claude"] else "-"
        sandbox = (user.get("sandbox_mode") or "default") if user["codex"] else "-"
        print(f"{name:<14}{user['port']:<7}{row['state']:<11}"
              f"{row['claude']:<10}{row['rc']:<9}{row['codex']:<10}{row['cx']:<9}"
              f"{spawn:<10}{perms:<18}{sandbox}")
    def detail(user: dict, label: str, text: str) -> None:
        print("  " + _c("2", f"{user['name']:<12} {label:<10} {text}"))

    for user, _ in rows:
        detail(user, "keys:", describe_key_sources(user))
    for user, row in rows:
        if row["last"]:
            detail(user, "rc.log:", row["last"])
        if row["codex_last"]:
            detail(user, "codex.log:", row["codex_last"])
    print()
    print(_c("2", f"ssh: ssh -p <PORT> dev@{host}   attach: … -t 'tmux attach -t rc'"))
    print(_c("2", "pair a phone with Codex: ./portal pair <name>"))


# ---------------------------------------------------------------------------
# status <name>: one user, in depth
# ---------------------------------------------------------------------------

# Outbound HTTPS from INSIDE the container, through the same login shell the
# agents run in. Any HTTP status at all means the way out works; only a curl
# error means it does not. Worth having because a host that loses Docker's NAT
# rules — `systemctl restart iptables` does it — shows every symptom as an agent
# problem: "connecting" forever, logins failing, model refreshes timing out.
NET_TARGETS = {"claude": "api.anthropic.com", "codex": "chatgpt.com"}
NET_TIMEOUT = 10


def _net_probe(name: str, host: str) -> tuple[bool, str]:
    res = exec_in(name, f"curl -s -m {NET_TIMEOUT} -o /dev/null -w '%{{http_code}} "
                        f"%{{time_total}} %{{exitcode}} %{{errormsg}}' https://{host}/")
    parts = (res.stdout or "").strip().split(" ", 3)
    if len(parts) < 3:
        return False, (res.stdout or res.stderr or "no output from curl").strip()
    code, secs, rc = parts[:3]
    if rc != "0":
        return False, f"curl exit {rc}: {parts[3] if len(parts) > 3 else ''}".strip()
    return True, f"HTTP {code} in {float(secs):.2f}s"


def _kv(key: str, text: str, dim: bool = False, width: int = 13) -> None:
    lines = text.splitlines() or [""]
    for i, line in enumerate(lines):
        print(f"  {key if i == 0 else '':<{width}}" + (_c("2", line) if dim else line))


def _parse_agent_env(text: str) -> dict[str, str]:
    """/run/agent.env is `KEY=<printf %q value>` lines."""
    env = {}
    for line in text.splitlines():
        key, sep, raw = line.partition("=")
        if sep and key.startswith("AGENT_"):
            try:
                words = shlex.split(raw)
            except ValueError:
                words = [raw]
            env[key] = words[0] if words else ""
    return env


def _pid_role(args: str) -> str:
    if "--managed-daemon" in args:
        return "daemon's app-server"
    if "pid-update-loop" in args:
        return "daemon's updater"
    if " app-server" in args:
        return "desktop app (over SSH)"
    return ""


def _status_detail(cfg: dict, user: dict) -> None:
    """Everything `status` knows about one user, plus what it concludes.

    Read-only, like the table: nothing here starts, stops or re-pairs anything.
    """
    name = user["name"]
    findings: list[str] = []
    print(_c("1", f"work-{name}") + _c("2", f"   ssh -p {user['port']} dev@{agent_host(cfg)}"))

    print("\n" + _c("1", "container"))
    try:
        info_ = json.loads(docker(["inspect", f"work-{name}"]).stdout)[0]
    except (ValueError, IndexError, TypeError):
        _kv("state", "absent")
        findings.append(f"work-{name} does not exist. './portal update' creates it.")
        _print_findings(findings)
        return
    state = info_["State"]["Status"]
    started = info_["State"].get("StartedAt", "")[:19].replace("T", " ")
    _kv("state", f"{state} since {started} UTC, {info_.get('RestartCount', 0)} restart(s)")
    current = docker(["image", "inspect", "-f", "{{.Id}}", IMAGE]).stdout.strip()
    if current and info_.get("Image") != current:
        _kv("image", f"older than {IMAGE}")
        findings.append(
            f"work-{name} runs an older image than {IMAGE}, so it lacks the current "
            "supervisor.sh and agent versions. './portal update' recreates it — which "
            "restarts it, so pick a moment when nothing long-running is in there.")
    else:
        _kv("image", f"current ({IMAGE})")
    _kv("keys", describe_key_sources(user))
    if state != "running":
        logs = docker(["logs", "--tail", "15", f"work-{name}"])
        _kv("docker logs", ((logs.stdout or "") + (logs.stderr or "")).strip(), dim=True)
        findings.append(f"work-{name} is {state}. 'docker logs work-{name}' says why; "
                        "'./portal update' brings it back.")
        _print_findings(findings)
        return

    probes = {
        "env": "cat /run/agent.env",
        "cpus": "nproc",
        "load": "cut -d' ' -f1-3 /proc/loadavg",
        "mem": "free -m | awk '/^Mem:/{print $2, $7}'",
        "pids": "cat /sys/fs/cgroup/pids.current /sys/fs/cgroup/pids.max",
    }
    if user["claude"]:
        probes |= {
            "claude_auth": "claude auth status",
            "claude_loop": "tmux has-session -t rc",
            "rc_log": "tail -n 8 ~/rc.log",
        }
    if user["codex"]:
        probes |= CODEX_DAEMON_PROBES | {
            "codex_login": "codex login status",
            "standalone": ('l=~/.codex/packages/standalone; if [ -L "$l" ]; then readlink "$l"; '
                           'elif [ -e "$l" ]; then echo "a real directory, not a link"; false; '
                           'else echo missing; false; fi'),
            "updater": _PIDFILE_SH + "pidfile app-server-updater",
            "procs": "ps -u dev -o pid=,ppid=,etime=,args=",
            "codex_log": "tail -n 8 ~/codex.log",
            "stderr": "tail -n 5 ~/.codex/app-server-daemon/app-server.stderr.log",
        }
    targets = [NET_TARGETS[agent] for agent in ("claude", "codex") if user[agent]]
    # The probes and the network checks run side by side: a dead network makes
    # each curl take the full timeout, and nobody should wait for that twice.
    with ThreadPoolExecutor() as pool:
        gathered = pool.submit(_gather, name, probes)
        nets = {host: pool.submit(_net_probe, name, host) for host in targets}
        probe = gathered.result()
        net = {host: fut.result() for host, fut in nets.items()}

    live = _parse_agent_env(probe["env"][1]) if probe["env"][0] == 0 else {}
    _kv("config", "  ".join(f"{k[6:].lower()}={v or '-'}" for k, v in live.items()
                            if k not in ("AGENT_NAME", "AGENT_HOST")) or "no /run/agent.env")
    drift = [f"{k[6:].lower()}: running {live.get(k) or '-'}, {USERS_YAML.name} says {v or '-'}"
             for k, v in agent_env(agent_host(cfg), user).items() if live and live.get(k, "") != v]
    if drift:
        _kv("  drift", "\n".join(drift))
        findings.append(f"{USERS_YAML.name} was changed after work-{name} started, and the "
                        "container still runs the old settings. './portal update' applies them.")

    print("\n" + _c("1", "resources"))
    try:
        cpus = int(probe["cpus"][1])
        load1 = float(probe["load"][1].split()[0])
        _kv("cpu", f"{cpus} cpus, load {probe['load'][1]}")
        if load1 > cpus:
            findings.append(f"load {load1:g} exceeds the {cpus} CPUs the container sees; "
                            "short-lived agent helpers can miss their timeouts.")
    except (ValueError, IndexError):
        _kv("cpu", probe["cpus"][1] or "?")
    try:
        total, avail = (int(x) for x in probe["mem"][1].split())
        _kv("memory", f"{avail} MiB available of {total} MiB")
        if avail < total * 0.05:
            findings.append(f"only {avail} MiB of memory left in work-{name}.")
    except ValueError:
        _kv("memory", probe["mem"][1] or "?")
    pids = probe["pids"][1].split()
    _kv("pids", " of ".join(pids) if pids else "?")
    if len(pids) == 2 and pids[1].isdigit() and int(pids[0]) > 0.9 * int(pids[1]):
        findings.append(f"work-{name} is close to its process limit ({pids[0]} of {pids[1]}).")

    if targets:
        print("\n" + _c("1", "network") + _c("2", "   outbound HTTPS from inside the container"))
        for host in targets:
            ok, text = net[host]
            _kv(host, (_c("32", "ok   ") if ok else _c("31", "FAIL ")) + text,
                width=max(13, max(map(len, targets)) + 2))
        failed = [host for host in targets if not net[host][0]]
        if failed:
            findings.append(
                f"work-{name} cannot reach {', '.join(failed)} over HTTPS, so nothing that "
                "needs the account works — remote control, logins, model calls — however "
                f"healthy the rest looks. Run 'curl -m 10 -I https://{failed[0]}/' on the "
                "host: if the host gets out and the container does not, Docker's NAT rules "
                "are gone, usually after "
                "'systemctl restart iptables' or a firewall reload; see \"Host firewall\" "
                "in docs/ADMIN.md.")

    if user["claude"]:
        print("\n" + _c("1", "claude"))
        rc, out = probe["claude_auth"]
        try:
            login = (json.loads(out).get("authMethod") or "ok") if rc == 0 else "NO LOGIN"
        except (ValueError, AttributeError):
            login = "ok"
        _kv("login", login)
        loop_up = probe["claude_loop"][0] == 0
        _kv("loop", "up (tmux session rc)" if loop_up else "down")
        _kv("rc.log", probe["rc_log"][1] or "(empty)", dim=True)
        if login == "NO LOGIN":
            findings.append(f"Claude is not signed in. './portal setup {name}' (needs the person).")
        if not loop_up:
            findings.append("the rc tmux session is gone; the supervisor restarts it within "
                            f"seconds. If it stays gone, 'docker logs work-{name}' says why.")

    if user["codex"]:
        print("\n" + _c("1", "codex"))
        rc, out = probe["codex_login"]
        _kv("login", out.splitlines()[0] if rc == 0 and out else "NO LOGIN")
        if rc != 0:
            findings.append(f"Codex is not signed in. './portal setup {name}' (needs the person).")
        rc, out = probe["standalone"]
        _kv("install", f"~/.codex/packages/standalone -> {out}" if rc == 0
            else f"~/.codex/packages/standalone is {out}")
        if rc != 0 or not out.startswith("/opt/codex/"):
            findings.append("~/.codex/packages/standalone does not point at the image's shared "
                            "install. The supervisor links it at boot unless a real directory is "
                            "in the way; ~/codex.log says which.")
        daemon = _classify_daemon(probe)
        try:
            version = json.loads(probe["daemon"][1]).get("managedCodexVersion") or ""
        except (ValueError, AttributeError):
            version = ""
        _kv("daemon", daemon + (f" ({version})" if version else ""))
        _kv("pid files", f"app-server: {probe['pidfile'][1]}\nupdater:    {probe['updater'][1]}")
        procs = []
        for line in probe["procs"][1].splitlines():
            parts = line.split(None, 3)
            if len(parts) == 4 and os.path.basename(parts[3].split()[0]).startswith("codex"):
                procs.append(parts)
        _kv("processes", "\n".join(
            f"{pid:>7} {etime:>12}  {_pid_role(args) or os.path.basename(args.split()[0])}"
            for pid, _, etime, args in procs) or "none")
        _kv("codex.log", probe["codex_log"][1] or "(empty)", dim=True)
        _kv("stderr log", probe["stderr"][1] or "(empty)", dim=True)

        if daemon == "orphan":
            daemon_pids = {pid for pid, _, _, args in procs
                           if "--managed-daemon" in args or "pid-update-loop" in args}
            stray = " ".join(pid for pid, ppid, _, _ in procs
                             if pid in daemon_pids or ppid in daemon_pids)
            findings.append(
                "the Codex daemon has lost track of its own app-server (pid file: "
                f"{probe['pidfile'][1]}). 'remote-control start' refuses from then on and "
                "nothing restarts that app-server, so once its connection drops the phone "
                "loses the container. A current supervisor.sh recovers from this on its next "
                "poll; on an older image, stop the daemon's processes and it starts clean "
                f"within a minute: docker exec work-{name} kill {stray or '<pids above>'}")
        elif daemon == "down":
            findings.append("no Codex daemon is running. The supervisor tries once a minute; "
                            "if it stays down, ~/codex.log says why.")
        elif daemon == "no-rc":
            findings.append("the Codex daemon runs with remote control off, so no phone can see "
                            "it. The supervisor turns it back on at its next poll.")
        last = (probe["codex_log"][1].splitlines() or [""])[-1]
        if "Error" in last and daemon != "orphan":   # orphan already explains its error
            findings.append(f"the latest state in ~/codex.log is an error: {last.split('] ', 1)[-1]}")

    _print_findings(findings)


def _print_findings(findings: list[str]) -> None:
    print("\n" + _c("1", "findings"))
    if not findings:
        print("  " + _c("32", "nothing wrong that these probes can see"))
        return
    for text in findings:
        lines = textwrap.wrap(text, width=76, break_on_hyphens=False)
        print("  " + _c("31", "!") + " " + lines[0])
        for line in lines[1:]:
            print("    " + line)


def cmd_status(args: argparse.Namespace) -> None:
    cfg = load_config()
    if getattr(args, "name", None):
        if args.quick:
            die("-q skips the in-container probes, which is all 'status <name>' is")
        _status_detail(cfg, find_user(cfg, args.name))
        return
    if not cfg["users"]:
        info("no users yet — ./portal add <name> --claude")
        return
    if not image_exists():
        warn(f"{IMAGE} is not built yet — run './portal update'")
    _print_status_rows(cfg, cfg["users"], quick=args.quick)


def cmd_build(args: argparse.Namespace) -> None:
    build_image(load_config(required=False), refresh=not args.no_pull)


def cmd_update(args: argparse.Namespace) -> None:
    cfg = load_config()
    build_image(cfg, refresh=not args.no_pull)
    render(cfg)
    if cfg["users"]:
        info("recreating containers (named volumes are untouched, so every "
             "login and every ~/.claude survives)")
        compose(cfg, ["up", "-d", "--force-recreate", "--remove-orphans"])
    print()
    cmd_status(argparse.Namespace(quick=True))


def cmd_rm(args: argparse.Namespace) -> None:
    cfg = load_config()
    user = find_user(cfg, args.name)
    name = user["name"]
    base, _, _ = user_dirs(cfg, name)

    if not args.yes and not confirm(f"stop and remove container work-{name}?"):
        die("aborted", 2)
    if container_state(name) != "absent":
        compose(cfg, ["rm", "-s", "-f", "-v", f"work-{name}"], check=False)

    cfg["users"] = [u for u in cfg["users"] if u["name"] != name]
    save_config(cfg)
    render(cfg)
    info(f"removed '{name}' from {USERS_YAML.name}")

    if args.purge:
        print()
        warn(f"--purge will PERMANENTLY delete:\n"
             f"           volume {name}-home  (~/.claude, ~/.codex, ~/.ssh, shell history)\n"
             f"           directory {base}    (all of their projects)")
        if args.yes or confirm("really delete both?"):
            docker(["volume", "rm", f"{name}-home"])
            shutil.rmtree(base, ignore_errors=True)
            info(f"purged {name}-home and {base}")
        else:
            info("kept the volume and project directory")
    else:
        info(f"kept volume {name}-home and {base} — "
             f"re-add the user to reconnect them, or rerun with --purge to delete")


def cmd_render(args: argparse.Namespace) -> None:
    render(load_config())


# ---------------------------------------------------------------------------

def main() -> None:
    # allow_abbrev=False everywhere: argparse otherwise accepts any unambiguous
    # prefix, so `--code` silently becomes `--codex` and a Claude-only user
    # quietly gets Codex enabled. Typos should be errors, not guesses.
    parser = argparse.ArgumentParser(
        prog="portal", description=__doc__, allow_abbrev=False,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)

    def add_parser(*a, **kw):
        # Subparsers do not inherit allow_abbrev from the parent.
        return sub.add_parser(*a, allow_abbrev=False, **kw)

    p = add_parser("add", help="create a work container for a person")
    p.add_argument("name")
    p.add_argument("--key", action="append", metavar="PUBKEY|PATH|-",
                   help="extra public key recorded in users.yaml, on top of the "
                        "host account's (repeatable; a literal key, a path, or '-')")
    p.add_argument("--no-host-keys", action="store_true",
                   help="do not read any host account's authorized_keys; use "
                        "only --key")
    p.add_argument("--host-user", metavar="ACCOUNT",
                   help="host account whose ~/.ssh/authorized_keys to use "
                        "(default: the same name)")
    p.add_argument("--authorized-keys", metavar="PATH",
                   help="use this authorized_keys file instead of resolving a "
                        "host account")
    p.add_argument("--claude", action="store_true", help="run the supervised remote-control loop")
    p.add_argument("--codex", action="store_true",
                   help="Codex: the desktop app over SSH, plus the supervised "
                        "remote-control daemon that phones pair with")
    p.add_argument("--port", type=int, help="host sshd port (default: next free from 2201)")
    p.add_argument("--spawn", choices=SPAWN_MODES, default="same-dir",
                   help="how Remote Control creates sessions (default: same-dir; "
                        "worktree requires --workdir to be a git repository)")
    p.add_argument("--skip-permissions", action="store_true",
                   help="shorthand for --permission-mode bypassPermissions: the "
                        "agent runs tools without prompting")
    p.add_argument("--permission-mode", choices=PERMISSION_MODES, default=None,
                   help="permission mode for Remote Control sessions "
                        "(default: Claude Code's own)")
    p.add_argument("--workdir", default=DEFAULT_WORKDIR, metavar="DIR",
                   help=f"working directory for the Remote Control server "
                        f"(default: {DEFAULT_WORKDIR})")
    p.add_argument("--sandbox-mode", choices=SANDBOX_MODES, default=None,
                   help="sandbox for Codex remote-control sessions "
                        "(default: Codex's own, workspace-write)")
    p.set_defaults(func=cmd_add)

    p = add_parser("setup", help="one-time interactive logins (needs a TTY)")
    p.add_argument("name")
    p.set_defaults(func=cmd_setup)

    p = add_parser("pair", help="print a fresh Codex pairing code for a phone")
    p.add_argument("name")
    p.set_defaults(func=cmd_pair)

    p = add_parser("status", help="show every container and its login state, "
                                  "or one user's in depth")
    p.add_argument("name", nargs="?",
                   help="report on this user alone, in depth: container, config, "
                        "resources, outbound network, both agents, and a diagnosis")
    p.add_argument("-q", "--quick", action="store_true",
                   help="skip the in-container probes (much faster)")
    p.set_defaults(func=cmd_status)

    p = add_parser("build", help="build agent-base:latest and stop (no containers touched)")
    p.add_argument("--no-pull", action="store_true",
                   help="build without forcing fresh agent downloads")
    p.set_defaults(func=cmd_build)

    p = add_parser("update", help="rebuild the image with the latest claude/codex "
                                      "and recreate all containers")
    p.add_argument("--no-pull", action="store_true",
                   help="rebuild without forcing fresh agent downloads")
    p.set_defaults(func=cmd_update)

    p = add_parser("rm", help="remove a user's container")
    p.add_argument("name")
    p.add_argument("--purge", action="store_true",
                   help="also delete their home volume and project directory")
    p.add_argument("-y", "--yes", action="store_true", help="do not ask")
    p.set_defaults(func=cmd_rm)

    p = add_parser("render", help="re-render compose.users.yml and authorized_keys")
    p.set_defaults(func=cmd_render)

    args = parser.parse_args()
    for var in BANNED_ENV:
        if var in os.environ:
            warn(f"{var} is set in your shell. portal strips it before touching docker, "
                 "but do not put it in any compose file: it breaks Remote Control.")
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
