def parse_keys(raw: str) -> list[str]:
    """Accept a literal public key, a path to a file of them, or '-' for stdin."""
    if raw == "-":
        text = sys.stdin.read()
    else:
        path = Path(raw).expanduser()
        text = path.read_text() if path.is_file() else raw
    keys = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if not KEY_RE.match(line):
            die(f"does not look like an SSH public key: {line[:60]!r}\n"
                "       (pass the contents of ~/.ssh/id_ed25519.pub, or its path)")
        keys.append(line)
    if not keys:
        die(f"no usable public key found in {raw!r}")
    return keys


def resolve_authorized_keys(name: str, host_user: str | None,
                            explicit: str | None) -> str | None:
    """Find the host authorized_keys file this container should read, if any.

    Nothing is copied: the path goes into users.yaml and is bind-mounted
    read-only, so the host account stays the source of truth for those keys.
    Returns None when there is no host account to read and extra_keys will
    carry the container on their own.
    """
    if explicit:
        path = Path(explicit).expanduser()
    else:
        who = host_user or name
        try:
            home = Path(pwd.getpwnam(who).pw_dir)
        except KeyError:
            return None
        path = home / ".ssh" / "authorized_keys"

    if not path.exists():
        die(f"{path} does not exist.\n"
            "       That file is what lets anyone log into the container, and\n"
            "       Docker would silently create a DIRECTORY in its place.\n"
            "       Create it first (ssh-copy-id, or touch it and paste a key in).")
    if not path.is_file():
        die(f"{path} is not a regular file")
    check_authorized_keys_file(path)
    return str(path.resolve())


def describe_key_sources(user: dict) -> str:
    bits = []
    if user.get("authorized_keys"):
        bits.append(Path(user["authorized_keys"]).as_posix())
    n = len(user.get("extra_keys") or [])
    if n:
        bits.append(f"{n} extra key(s) in {USERS_YAML.name}")
    return " + ".join(bits) or "nothing"


def check_authorized_keys_file(path: Path) -> None:
    """Warn about anything that will make this container unreachable."""
    try:
        lines = [ln.strip() for ln in path.read_text().splitlines()]
    except OSError as exc:
        die(f"cannot read {path}: {exc.strerror}")
    keys = [ln for ln in lines if ln and not ln.startswith("#")]
    if not keys:
        warn(f"{path} has no keys in it — nobody will be able to log in")
        return
    bad = [k for k in keys if not KEY_RE.match(k)]
    if bad:
        warn(f"{path}: {len(bad)} line(s) do not look like SSH public keys, e.g. "
             f"{bad[0][:50]!r}")
    info(f"{path} — {len(keys)} key(s)")


def user_dirs(cfg: dict, name: str) -> tuple[Path, Path, Path]:
    base = Path(cfg["srv_root"]) / name
    return base, base / "projects", base / "ssh"


def agent_env(host: str, user: dict) -> dict[str, str]:
    """The AGENT_* environment a user's container is started with.

    `status <name>` compares this against the container's /run/agent.env to
    spot a users.yaml edit that was never applied.
    """
    return {
        "AGENT_NAME": user["name"],
        "AGENT_HOST": host,
        "AGENT_CLAUDE": "1" if user["claude"] else "0",
        "AGENT_CODEX": "1" if user["codex"] else "0",
        "AGENT_SPAWN": user.get("spawn", "same-dir"),
        "AGENT_WORKDIR": user.get("workdir", DEFAULT_WORKDIR),
        # Empty means "do not pass the flag at all".
        "AGENT_PERMISSION_MODE": user.get("permission_mode") or "",
        "AGENT_SANDBOX_MODE": user.get("sandbox_mode") or "",
    }


def render(cfg: dict, quiet: bool = False) -> None:
    uid, gid = build_uid_gid(cfg)
    host = agent_host(cfg)
    services: dict = {}
    volumes: dict = {}

    seen_ports: dict[int, str] = {}
    for user in cfg["users"]:
        name = user["name"]
        if not NAME_RE.match(name):
            die(f"invalid user name {name!r}: lowercase letters, digits and dashes only")
        port = int(user["port"])
        if port in seen_ports:
            die(f"port {port} is claimed by both '{seen_ports[port]}' and '{name}'")
        seen_ports[port] = name

        base, projects, sshdir = user_dirs(cfg, name)
        try:
            projects.mkdir(parents=True, exist_ok=True)
            sshdir.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            die(f"cannot create {base}: {exc.strerror} — run portal as root, or "
                f"give yourself write access to {cfg['srv_root']}")
        try:
            os.chown(projects, uid, gid)
        except (PermissionError, OSError):
            warn(f"could not chown {projects} to {uid}:{gid} — run portal as root "
                 "or fix it by hand if the container cannot write there")

        akeys = user.get("authorized_keys")
        extra = user.get("extra_keys") or []
        if not akeys and not extra:
            die(f"user '{name}' has neither authorized_keys nor extra_keys in "
                f"{USERS_YAML.name} — nobody could log into work-{name}")
        if akeys and not Path(akeys).is_file():
            # Docker would create a DIRECTORY at a missing bind source, inside
            # somebody's ~/.ssh. Refuse rather than let that happen.
            die(f"{akeys} (for '{name}') is missing or is not a regular file.\n"
                f"       Recreate it, or point '{name}' at another file in "
                f"{USERS_YAML.name}.")

        # The extra keys, rendered into a portal-owned directory that is mounted
        # read-only. A DIRECTORY mount, not a file one, so rewriting this file
        # is picked up without recreating the container.
        try:
            os.chmod(sshdir, 0o755)
            (sshdir / "extra").write_text(
                f"# GENERATED by ./portal from {USERS_YAML.name} — do not edit.\n"
                f"# extra_keys for '{name}'\n" + "".join(k + "\n" for k in extra))
            os.chmod(sshdir / "extra", 0o644)
        except OSError as exc:
            die(f"cannot write {sshdir / 'extra'}: {exc.strerror}")

        # Both key sources are staged under /run rather than mounted onto the
        # path sshd reads: the host file arrives with the HOST user's
        # ownership, which StrictModes rejects. supervisor.sh concatenates them
        # into a root-owned copy.
        mounts: list = [
            f"{name}-home:/home/dev",
            f"{projects}:/home/dev/projects",
            f"{sshdir}:/run/portal-keys:ro",
        ]
        if akeys:
            mounts.append({
                "type": "bind",
                "source": akeys,
                "target": "/run/host-authorized-keys",
                "read_only": True,
                # A missing source must be an error, not Docker inventing a
                # directory called authorized_keys in someone's ~/.ssh.
                "bind": {"create_host_path": False},
            })

        services[f"work-{name}"] = {
            "image": IMAGE,
            "container_name": f"work-{name}",
            "hostname": name,
            "restart": "unless-stopped",
            "stop_grace_period": "20s",
            "environment": agent_env(host, user),
            "ports": [f"0.0.0.0:{port}:22"],
            "volumes": mounts,
        }
        volumes[f"{name}-home"] = {"name": f"{name}-home"}

    doc = {"services": services}
    if volumes:
        doc["volumes"] = volumes

    with USERS_COMPOSE.open("w") as fh:
        fh.write("# GENERATED by ./portal from users.yaml — do not edit.\n"
                 "# Regenerate with: ./portal render\n")
        yaml.safe_dump(doc, fh, sort_keys=False, default_flow_style=False, width=120)
    if not quiet:
        info(f"rendered {USERS_COMPOSE.name} ({len(services)} container(s))")


