#!/usr/bin/env python3
"""portal — manage per-person AI agent work containers on this host.

Each container accepts two sets of keys, concatenated:

  * the person's own ~/.ssh/authorized_keys from their host account, bind-mounted
    read-only, so rotating a key on the host rotates it in the container;
  * any extra_keys listed for them in users.yaml, for machines or people that
    have no account on this host.

Either may be omitted, but not both.

    ./portal build              build agent-base:latest
    ./portal add <name> [--key <pubkey|path>]... [--claude] [--codex]
    ./portal setup <name>       one-time interactive logins (needs a TTY)
    ./portal status [-q]
    ./portal update             rebuild the image, recreate containers
    ./portal rm <name> [--purge]
    ./portal render             re-render compose.users.yml + authorized_keys

Runs on the host only. No container is ever given the docker socket.
"""

from __future__ import annotations

import argparse
import datetime
import json
import os
import re
import shutil
import pwd
import socket
import subprocess
import sys
import time
from pathlib import Path

try:
    import yaml
except ImportError:
    sys.exit(
        f"portal needs PyYAML, and {sys.executable} cannot import it.\n"
        "  Arch/Manjaro:  sudo pacman -S python-yaml\n"
        "  Debian/Ubuntu: sudo apt-get install -y python3-yaml\n"
        "  Fedora/RHEL:   sudo dnf install python3-pyyaml\n"
        "  any of them:   pip install PyYAML\n"
        "\n"
        "If the distro package is already installed, this interpreter is not the\n"
        "system one (a venv, pyenv, mise or conda build cannot see distro\n"
        "site-packages). Either install PyYAML into it, or run the system python\n"
        "explicitly:  /usr/bin/python3 ./portal ..."
    )

ROOT = Path(__file__).resolve().parent
USERS_YAML = ROOT / "users.yaml"
USERS_YAML_EXAMPLE = ROOT / "users.yaml.example"
BASE_COMPOSE = ROOT / "docker-compose.yml"
USERS_COMPOSE = ROOT / "compose.users.yml"

IMAGE = "agent-base:latest"
DEFAULT_SRV_ROOT = "/srv/agents"
PORT_BASE = 2201
PORT_CEILING = 2299
NAME_RE = re.compile(r"^[a-z][a-z0-9-]{0,30}$")
KEY_RE = re.compile(r"^(ssh-(rsa|ed25519|dss)|ecdsa-sha2-\S+|sk-ssh-ed25519@\S+|sk-ecdsa-sha2-\S+)\s+\S+")

BANNED_ENV = (
    "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN",
    "ANTHROPIC_BASE_URL", "DISABLE_TELEMETRY", "DO_NOT_TRACK",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC", "DISABLE_GROWTHBOOK",
)


# --------------------------------------------------------------------------- 
# output
# ---------------------------------------------------------------------------

_TTY = sys.stdout.isatty()


def _c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if _TTY else text


def info(msg: str) -> None:
    print(f"{_c('36', '==>')} {msg}")


def warn(msg: str) -> None:
    print(f"{_c('33', 'warning:')} {msg}", file=sys.stderr)


def die(msg: str, code: int = 1) -> "NoReturn":  # type: ignore[valid-type]
    print(f"{_c('31', 'error:')} {msg}", file=sys.stderr)
    sys.exit(code)


def confirm(question: str, default: bool = False) -> bool:
    if not sys.stdin.isatty():
        return default
    suffix = "[y/N]" if not default else "[Y/n]"
    answer = input(f"{question} {suffix} ").strip().lower()
    if not answer:
        return default
    return answer in ("y", "yes")


# ---------------------------------------------------------------------------
# config
# ---------------------------------------------------------------------------

def load_config(required: bool = True) -> dict:
    if not USERS_YAML.exists():
        if required:
            die(f"{USERS_YAML} does not exist. Copy {USERS_YAML_EXAMPLE.name} to "
                f"users.yaml, or start with: ./portal add <name> --claude")
        return {"srv_root": DEFAULT_SRV_ROOT, "users": []}
    with USERS_YAML.open() as fh:
        cfg = yaml.safe_load(fh) or {}
    if not isinstance(cfg, dict):
        die(f"{USERS_YAML} must be a mapping with a 'users:' key")
    cfg.setdefault("srv_root", DEFAULT_SRV_ROOT)
    cfg.setdefault("users", [])
    if cfg["users"] is None:
        cfg["users"] = []
    for user in cfg["users"]:
        user.setdefault("claude", False)
        user.setdefault("codex", False)
        user.setdefault("extra_keys", [])
        if user.get("keys"):
            die(f"user '{user['name']}' still has a 'keys:' block, which no "
                "longer means anything. Rename it to 'extra_keys:', and/or add\n"
                f"         authorized_keys: /home/{user['name']}/.ssh/authorized_keys\n"
                "       to read that host account's keys as well.")
    return cfg


def save_config(cfg: dict) -> None:
    header = (
        "# users.yaml — the single source of truth for this agent host.\n"
        "# Maintained by ./portal; hand edits are fine but comments are not\n"
        "# preserved across `portal add` / `portal rm`.\n"
        f"# Last written {datetime.datetime.now().isoformat(timespec='seconds')}\n"
    )
    tmp = USERS_YAML.with_suffix(".yaml.tmp")
    with tmp.open("w") as fh:
        fh.write(header)
        yaml.safe_dump(cfg, fh, sort_keys=False, default_flow_style=False, width=100)
    tmp.replace(USERS_YAML)


def find_user(cfg: dict, name: str) -> dict:
    for user in cfg["users"]:
        if user["name"] == name:
            return user
    die(f"no user '{name}' in {USERS_YAML.name}. Known: "
        + (", ".join(u["name"] for u in cfg["users"]) or "(none)"))


def agent_host(cfg: dict) -> str:
    return cfg.get("host") or socket.gethostname()


def build_uid_gid(cfg: dict) -> tuple[int, int]:
    """UID/GID baked into the image, so bind-mounted projects are writable
    from both the host and the container without any chown dance.

    Pin them with `uid:`/`gid:` in users.yaml if portal gets run by different
    people — changing them rebuilds the image.
    """
    uid = cfg.get("uid")
    gid = cfg.get("gid")
    # Under sudo, getuid() is 0. Baking that in would mean `useradd -u 0 dev`,
    # which collides with root and fails the build — so prefer the invoking
    # user, and fall back to 1000 for a genuine root shell.
    if uid is None:
        uid = int(os.environ.get("SUDO_UID") or os.getuid())
    if gid is None:
        gid = int(os.environ.get("SUDO_GID") or os.getgid())
    uid, gid = int(uid), int(gid)
    if uid == 0 or gid == 0:
        warn("running as root with no SUDO_UID to fall back on; building the "
             "image with uid/gid 1000. Set uid:/gid: in users.yaml to pin this "
             "to whoever owns your project directories.")
        uid = uid or 1000
        gid = gid or 1000
    return uid, gid


# ---------------------------------------------------------------------------
# docker
# ---------------------------------------------------------------------------

def docker_bin() -> str:
    if not shutil.which("docker"):
        die("docker is not on PATH")
    return "docker"


def compose_cmd(cfg: dict) -> list[str]:
    cmd = [docker_bin(), "compose", "-f", str(BASE_COMPOSE)]
    if USERS_COMPOSE.exists() and cfg["users"]:
        cmd += ["-f", str(USERS_COMPOSE)]
    return cmd


def compose(cfg: dict, args: list[str], check: bool = True,
            capture: bool = False) -> subprocess.CompletedProcess:
    uid, gid = build_uid_gid(cfg)
    env = {k: v for k, v in os.environ.items() if k not in BANNED_ENV}
    env["DEV_UID"] = str(uid)
    env["DEV_GID"] = str(gid)
    env.setdefault("REFRESH", "0")
    proc = subprocess.run(compose_cmd(cfg) + args, env=env, check=False,
                          capture_output=capture, text=True)
    if check and proc.returncode != 0:
        if capture and proc.stderr:
            print(proc.stderr, file=sys.stderr)
        die(f"docker compose {' '.join(args)} failed (exit {proc.returncode})")
    return proc


def docker(args: list[str], check: bool = False,
           capture: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run([docker_bin()] + args, check=check,
                          capture_output=capture, text=True)


def container_state(name: str) -> str:
    proc = docker(["inspect", "-f", "{{.State.Status}}", f"work-{name}"])
    return proc.stdout.strip() if proc.returncode == 0 else "absent"


def image_exists() -> bool:
    return docker(["image", "inspect", IMAGE]).returncode == 0


def exec_in(name: str, script: str, tty: bool = False,
            capture: bool = True) -> subprocess.CompletedProcess:
    """Run a bash LOGIN shell as dev inside a work container.

    -l matters: it is what puts /etc/profile.d on the path, which is the same
    shape the Codex desktop app relies on.
    """
    flags = ["-i", "-t"] if tty else []
    cmd = [docker_bin(), "exec", *flags, f"work-{name}",
           "su", "-l", "dev", "-c", script]
    if tty:
        return subprocess.run(cmd, check=False)
    return subprocess.run(cmd, check=False, capture_output=capture, text=True)


