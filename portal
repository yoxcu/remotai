def parse_keys(raw: str) -> list[str]:
    """Accept a literal public key, a path to a file of them, or '-' for stdin."""
    if raw == "-":
        text = sys.stdin.read()
    else:
        path = Path(raw).expanduser()
        text = path.read_text() if path.is_file() else raw
    keys = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if not KEY_RE.match(line):
            die(f"does not look like an SSH public key: {line[:60]!r}\n"
                "       (pass the contents of ~/.ssh/id_ed25519.pub, or its path)")
        keys.append(line)
    if not keys:
        die(f"no usable public key found in {raw!r}")
    return keys


def resolve_authorized_keys(name: str, host_user: str | None,
                            explicit: str | None) -> str | None:
    """Find the host authorized_keys file this container should read, if any.

    Nothing is copied: the path goes into users.yaml and is bind-mounted
    read-only, so the host account stays the source of truth for those keys.
    Returns None when there is no host account to read and extra_keys will
    carry the container on their own.
    """
    if explicit:
        path = Path(explicit).expanduser()
    else:
        who = host_user or name
        try:
            home = Path(pwd.getpwnam(who).pw_dir)
        except KeyError:
            return None
        path = home / ".ssh" / "authorized_keys"

    if not path.exists():
        die(f"{path} does not exist.\n"
            "       That file is what lets anyone log into the container, and\n"
            "       Docker would silently create a DIRECTORY in its place.\n"
            "       Create it first (ssh-copy-id, or touch it and paste a key in).")
    if not path.is_file():
        die(f"{path} is not a regular file")
    check_authorized_keys_file(path)
    return str(path.resolve())


def describe_key_sources(user: dict) -> str:
    bits = []
    if user.get("authorized_keys"):
        bits.append(Path(user["authorized_keys"]).as_posix())
    n = len(user.get("extra_keys") or [])
    if n:
        bits.append(f"{n} extra key(s) in {USERS_YAML.name}")
    return " + ".join(bits) or "nothing"


def check_authorized_keys_file(path: Path) -> None:
    """Warn about anything that will make this container unreachable."""
    try:
        lines = [ln.strip() for ln in path.read_text().splitlines()]
    except OSError as exc:
        die(f"cannot read {path}: {exc.strerror}")
    keys = [ln for ln in lines if ln and not ln.startswith("#")]
    if not keys:
        warn(f"{path} has no keys in it — nobody will be able to log in")
        return
    bad = [k for k in keys if not KEY_RE.match(k)]
    if bad:
        warn(f"{path}: {len(bad)} line(s) do not look like SSH public keys, e.g. "
             f"{bad[0][:50]!r}")
    info(f"{path} — {len(keys)} key(s)")


def user_dirs(cfg: dict, name: str) -> tuple[Path, Path, Path]:
    base = Path(cfg["srv_root"]) / name
    return base, base / "projects", base / "ssh"


def render(cfg: dict, quiet: bool = False) -> None:
    uid, gid = build_uid_gid(cfg)
    host = agent_host(cfg)
    services: dict = {}
    volumes: dict = {}

    seen_ports: dict[int, str] = {}
    for user in cfg["users"]:
        name = user["name"]
        if not NAME_RE.match(name):
            die(f"invalid user name {name!r}: lowercase letters, digits and dashes only")
        port = int(user["port"])
        if port in seen_ports:
            die(f"port {port} is claimed by both '{seen_ports[port]}' and '{name}'")
        seen_ports[port] = name

        base, projects, sshdir = user_dirs(cfg, name)
        try:
            projects.mkdir(parents=True, exist_ok=True)
            sshdir.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            die(f"cannot create {base}: {exc.strerror} — run portal as root, or "
                f"give yourself write access to {cfg['srv_root']}")
        try:
            os.chown(projects, uid, gid)
        except (PermissionError, OSError):
            warn(f"could not chown {projects} to {uid}:{gid} — run portal as root "
                 "or fix it by hand if the container cannot write there")

        akeys = user.get("authorized_keys")
        extra = user.get("extra_keys") or []
        if not akeys and not extra:
            die(f"user '{name}' has neither authorized_keys nor extra_keys in "
                f"{USERS_YAML.name} — nobody could log into work-{name}")
        if akeys and not Path(akeys).is_file():
            # Docker would create a DIRECTORY at a missing bind source, inside
            # somebody's ~/.ssh. Refuse rather than let that happen.
            die(f"{akeys} (for '{name}') is missing or is not a regular file.\n"
                f"       Recreate it, or point '{name}' at another file in "
                f"{USERS_YAML.name}.")

        # The extra keys, rendered into a portal-owned directory that is mounted
        # read-only. A DIRECTORY mount, not a file one, so rewriting this file
        # is picked up without recreating the container.
        try:
            os.chmod(sshdir, 0o755)
            (sshdir / "extra").write_text(
                f"# GENERATED by ./portal from {USERS_YAML.name} — do not edit.\n"
                f"# extra_keys for '{name}'\n" + "".join(k + "\n" for k in extra))
            os.chmod(sshdir / "extra", 0o644)
        except OSError as exc:
            die(f"cannot write {sshdir / 'extra'}: {exc.strerror}")

        # Both key sources are staged under /run rather than mounted onto the
        # path sshd reads: the host file arrives with the HOST user's
        # ownership, which StrictModes rejects. supervisor.sh concatenates them
        # into a root-owned copy.
        mounts: list = [
            f"{name}-home:/home/dev",
            f"{projects}:/home/dev/projects",
            f"{sshdir}:/run/portal-keys:ro",
        ]
        if akeys:
            mounts.append({
                "type": "bind",
                "source": akeys,
                "target": "/run/host-authorized-keys",
                "read_only": True,
                # A missing source must be an error, not Docker inventing a
                # directory called authorized_keys in someone's ~/.ssh.
                "bind": {"create_host_path": False},
            })

        services[f"work-{name}"] = {
            "image": IMAGE,
            "container_name": f"work-{name}",
            "hostname": name,
            "restart": "unless-stopped",
            "stop_grace_period": "20s",
            "environment": {
                "AGENT_NAME": name,
                "AGENT_HOST": host,
                "AGENT_CLAUDE": "1" if user["claude"] else "0",
                "AGENT_CODEX": "1" if user["codex"] else "0",
            },
            "ports": [f"0.0.0.0:{port}:22"],
            "volumes": mounts,
        }
        volumes[f"{name}-home"] = {"name": f"{name}-home"}

    doc = {"services": services}
    if volumes:
        doc["volumes"] = volumes

    with USERS_COMPOSE.open("w") as fh:
        fh.write("# GENERATED by ./portal from users.yaml — do not edit.\n"
                 "# Regenerate with: ./portal render\n")
        yaml.safe_dump(doc, fh, sort_keys=False, default_flow_style=False, width=120)
    if not quiet:
        info(f"rendered {USERS_COMPOSE.name} ({len(services)} container(s))")


# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------

def ensure_image(cfg: dict) -> None:
    if image_exists():
        return
    info(f"{IMAGE} does not exist yet — building it")
    build_image(cfg, refresh=False)


def build_image(cfg: dict, refresh: bool) -> None:
    uid, gid = build_uid_gid(cfg)
    env = {k: v for k, v in os.environ.items() if k not in BANNED_ENV}
    env["DEV_UID"] = str(uid)
    env["DEV_GID"] = str(gid)
    # Busting REFRESH invalidates only the npm layer, so claude and codex come
    # down fresh while the apt layers and your toolchain hook stay cached.
    env["REFRESH"] = str(int(time.time())) if refresh else "0"
    info(f"building {IMAGE} (uid={uid} gid={gid}"
         + (f", REFRESH={env['REFRESH']}" if refresh else "") + ")")
    proc = subprocess.run(
        [docker_bin(), "compose", "-f", str(BASE_COMPOSE),
         "--profile", "build", "build", "agent-base"],
        env=env, check=False)
    if proc.returncode != 0:
        die("image build failed")


def cmd_add(args: argparse.Namespace) -> None:
    cfg = load_config(required=False)
    name = args.name
    if not NAME_RE.match(name):
        die(f"invalid name {name!r}: must start with a lowercase letter and "
            "contain only lowercase letters, digits and dashes (max 31 chars)")
    if any(u["name"] == name for u in cfg["users"]):
        die(f"user '{name}' already exists — use './portal rm {name}' first, "
            f"or edit {USERS_YAML.name}")

    extra: list[str] = []
    for raw in (args.key or []):
        extra.extend(parse_keys(raw))

    akeys = None
    if not args.no_host_keys:
        akeys = resolve_authorized_keys(name, args.host_user, args.authorized_keys)
        if akeys is None:
            who = args.host_user or name
            if not extra:
                die(f"no host account called {who!r} and no --key given.\n"
                    f"       Create the account, or pick a source:\n"
                    f"         ./portal add {name} --key ~/keys/{name}.pub\n"
                    f"         ./portal add {name} --host-user <existing-account>\n"
                    f"         ./portal add {name} --authorized-keys /path/to/file")
            warn(f"no host account called {who!r}; using only the "
                 f"{len(extra)} key(s) from --key")

    taken = {int(u["port"]) for u in cfg["users"]}
    if args.port:
        port = args.port
        if port in taken:
            die(f"port {port} is already taken")
    else:
        port = next((p for p in range(PORT_BASE, PORT_CEILING + 1) if p not in taken), None)
        if port is None:
            die(f"no free port in {PORT_BASE}..{PORT_CEILING}")

    claude = args.claude
    codex = args.codex
    if not claude and not codex:
        warn("neither --claude nor --codex given; creating an SSH-only container. "
             f"Edit {USERS_YAML.name} and run './portal update' to change that.")

    entry = {"name": name, "port": port, "claude": claude, "codex": codex}
    if akeys:
        entry["authorized_keys"] = akeys
    if extra:
        entry["extra_keys"] = extra
    cfg["users"].append(entry)
    cfg["users"].sort(key=lambda u: u["name"])
    save_config(cfg)
    info(f"added '{name}' to {USERS_YAML.name} (port {port}, "
         f"claude={claude}, codex={codex})")
    info(f"keys come from: {describe_key_sources(entry)}")

    render(cfg)
    ensure_image(cfg)
    compose(cfg, ["up", "-d", f"work-{name}"])

    host = agent_host(cfg)
    print()
    info(f"work-{name} is up. Next:")
    print(f"     1. check SSH:   ssh -p {port} dev@{host}")
    if claude or codex:
        print(f"     2. one-time logins: ./portal setup {name}")
    if codex:
        print(f"     3. send them docs/USER-CODEX.md (port {port})")
    if claude:
        print("     4. send them docs/USER-CLAUDE.md")


def _step(n: int, total: int, title: str) -> None:
    print()
    print(_c("1;36", f"── step {n}/{total}: {title} " + "─" * max(0, 50 - len(title))))


def cmd_setup(args: argparse.Namespace) -> None:
    if not sys.stdin.isatty():
        die("`portal setup` is interactive and needs a TTY "
            "(both agents print a URL and wait for you to paste a code back)")
    cfg = load_config()
    user = find_user(cfg, args.name)
    name = user["name"]
    if container_state(name) != "running":
        die(f"work-{name} is not running (state: {container_state(name)}). "
            f"Try './portal update' first.")

    steps = []
    if user["claude"]:
        steps += ["claude auth login", "accept workspace trust", "enable remote control"]
    if user["codex"]:
        steps += ["codex login"]
    if not steps:
        die(f"user '{name}' has neither claude nor codex enabled in {USERS_YAML.name}")
    total = len(steps) + 1
    n = 0

    # Hold the supervised loop off while we drive the same directory by hand.
    exec_in(name, "touch /home/dev/.rc-paused")
    exec_in(name, "tmux kill-session -t rc 2>/dev/null || true")
    try:
        if user["claude"]:
            n += 1
            _step(n, total, "claude auth login")
            print("Sign in with the claude.ai account that should own this container's\n"
                  "sessions. Claude Code prints a URL; open it, approve, paste the code back.\n"
                  "This is the ONLY supported login for Remote Control — not `setup-token`,\n"
                  "not an API key.\n")
            exec_in(name, "cd /home/dev/projects && claude auth login", tty=True)
            if exec_in(name, "claude auth status").returncode != 0:
                die("still not signed in — rerun './portal setup %s'" % name)
            info("signed in")

            n += 1
            _step(n, total, "accept workspace trust for /home/dev/projects")
            print("Claude Code never persists trust for $HOME itself, which is why the\n"
                  "Remote Control server runs from /home/dev/projects. Accept the trust\n"
                  "prompt for that directory once, then leave the session (/exit).\n")
            input("press enter to start claude in /home/dev/projects … ")
            exec_in(name, "cd /home/dev/projects && claude", tty=True)

            n += 1
            _step(n, total, "enable remote control")
            print("Answer 'y' to \"Enable Remote Control?\". Once it says it is connected,\n"
                  "press Ctrl-C to come back here — the supervised loop takes over from\n"
                  "there and will restore these sessions on every restart.\n")
            input("press enter to start claude remote-control … ")
            exec_in(name, "cd /home/dev/projects && claude remote-control "
                          f"--name '{name}@{agent_host(cfg)}' --spawn worktree", tty=True)

        if user["codex"]:
            n += 1
            _step(n, total, "codex login")
            print("Codex uses a device-code flow: it prints a URL and a code, you approve\n"
                  "it in a browser on your own machine.\n")
            exec_in(name, "cd /home/dev/projects && codex login --device-auth", tty=True)
            status = exec_in(name, "codex login status")
            if status.returncode != 0:
                warn("codex still reports no login:\n" + (status.stdout or status.stderr).strip())
            else:
                info("codex signed in")
    finally:
        exec_in(name, "rm -f /home/dev/.rc-paused")

    n += 1
    _step(n, total, "restart the container")
    compose(cfg, ["up", "-d", "--force-recreate", f"work-{name}"])
    info("waiting for the remote-control loop to come up …")
    for _ in range(20):
        time.sleep(2)
        if exec_in(name, "tmux has-session -t rc").returncode == 0:
            break
    print()
    _print_status_rows(cfg, [user], quick=False)
    print()
    print("Attach to the live session any time with:")
    print(f"     ssh -p {user['port']} dev@{agent_host(cfg)} -t 'tmux attach -t rc'")


def _probe(name: str, state: str, quick: bool) -> dict:
    row = {"state": state, "claude": "-", "codex": "-", "rc": "-", "last": ""}
    if quick or state != "running":
        return row
    # `claude auth status` exits non-zero when logged out and otherwise prints
    # JSON. Show authMethod rather than a bare "ok": an API-key login reports
    # itself as logged in but Remote Control will never work with it.
    res = exec_in(name, "claude auth status")
    if res.returncode != 0:
        row["claude"] = "NO LOGIN"
    else:
        try:
            row["claude"] = (json.loads(res.stdout).get("authMethod") or "ok")[:9]
        except (ValueError, TypeError):
            row["claude"] = "ok"
    row["codex"] = "ok" if exec_in(name, "codex login status").returncode == 0 else "NO LOGIN"
    row["rc"] = "up" if exec_in(name, "tmux has-session -t rc").returncode == 0 else "down"
    tail = exec_in(name, "tail -n 1 /home/dev/rc.log 2>/dev/null")
    row["last"] = tail.stdout.strip()[:88]
    return row


def _print_status_rows(cfg: dict, users: list[dict], quick: bool) -> None:
    host = agent_host(cfg)
    hdr = f"{'NAME':<14}{'PORT':<7}{'STATE':<11}{'CLAUDE':<10}{'CODEX':<10}{'RC LOOP':<9}"
    print(_c("1", hdr))
    rows = []
    for user in users:
        name = user["name"]
        state = container_state(name)
        row = _probe(name, state, quick)
        if not user["claude"]:
            row["claude"] = row["rc"] = "off"
        if not user["codex"]:
            row["codex"] = "off"
        rows.append((user, row))
        print(f"{name:<14}{user['port']:<7}{row['state']:<11}"
              f"{row['claude']:<10}{row['codex']:<10}{row['rc']:<9}")
    for user, row in rows:
        print(f"  {_c('2', user['name'] + ' keys:   ' + describe_key_sources(user))}")
    for user, row in rows:
        if row["last"]:
            print(f"  {_c('2', user['name'] + ' rc.log: ' + row['last'])}")
    print()
    print(_c("2", f"ssh: ssh -p <PORT> dev@{host}   attach: … -t 'tmux attach -t rc'"))


def cmd_status(args: argparse.Namespace) -> None:
    cfg = load_config()
    if not cfg["users"]:
        info("no users yet — ./portal add <name> --claude")
        return
    if not image_exists():
        warn(f"{IMAGE} is not built yet — run './portal update'")
    _print_status_rows(cfg, cfg["users"], quick=args.quick)


def cmd_build(args: argparse.Namespace) -> None:
    build_image(load_config(required=False), refresh=not args.no_pull)


def cmd_update(args: argparse.Namespace) -> None:
    cfg = load_config()
    build_image(cfg, refresh=not args.no_pull)
    render(cfg)
    if cfg["users"]:
        info("recreating containers (named volumes are untouched, so every "
             "login and every ~/.claude survives)")
        compose(cfg, ["up", "-d", "--force-recreate", "--remove-orphans"])
    print()
    cmd_status(argparse.Namespace(quick=True))


def cmd_rm(args: argparse.Namespace) -> None:
    cfg = load_config()
    user = find_user(cfg, args.name)
    name = user["name"]
    base, _, _ = user_dirs(cfg, name)

    if not args.yes and not confirm(f"stop and remove container work-{name}?"):
        die("aborted", 2)
    if container_state(name) != "absent":
        compose(cfg, ["rm", "-s", "-f", "-v", f"work-{name}"], check=False)

    cfg["users"] = [u for u in cfg["users"] if u["name"] != name]
    save_config(cfg)
    render(cfg)
    info(f"removed '{name}' from {USERS_YAML.name}")

    if args.purge:
        print()
        warn(f"--purge will PERMANENTLY delete:\n"
             f"           volume {name}-home  (~/.claude, ~/.codex, ~/.ssh, shell history)\n"
             f"           directory {base}    (all of their projects)")
        if args.yes or confirm("really delete both?"):
            docker(["volume", "rm", f"{name}-home"])
            shutil.rmtree(base, ignore_errors=True)
            info(f"purged {name}-home and {base}")
        else:
            info("kept the volume and project directory")
    else:
        info(f"kept volume {name}-home and {base} — "
             f"re-add the user to reconnect them, or rerun with --purge to delete")


def cmd_render(args: argparse.Namespace) -> None:
    render(load_config())


# ---------------------------------------------------------------------------

def main() -> None:
    parser = argparse.ArgumentParser(
        prog="portal", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("add", help="create a work container for a person")
    p.add_argument("name")
    p.add_argument("--key", action="append", metavar="PUBKEY|PATH|-",
                   help="extra public key recorded in users.yaml, on top of the "
                        "host account's (repeatable; a literal key, a path, or '-')")
    p.add_argument("--no-host-keys", action="store_true",
                   help="do not read any host account's authorized_keys; use "
                        "only --key")
    p.add_argument("--host-user", metavar="ACCOUNT",
                   help="host account whose ~/.ssh/authorized_keys to use "
                        "(default: the same name)")
    p.add_argument("--authorized-keys", metavar="PATH",
                   help="use this authorized_keys file instead of resolving a "
                        "host account")
    p.add_argument("--claude", action="store_true", help="run the supervised remote-control loop")
    p.add_argument("--codex", action="store_true", help="allow the Codex desktop app over SSH")
    p.add_argument("--port", type=int, help="host sshd port (default: next free from 2201)")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("setup", help="one-time interactive logins (needs a TTY)")
    p.add_argument("name")
    p.set_defaults(func=cmd_setup)

    p = sub.add_parser("status", help="show every container and its login state")
    p.add_argument("-q", "--quick", action="store_true",
                   help="skip the in-container probes (much faster)")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("build", help="build agent-base:latest and stop (no containers touched)")
    p.add_argument("--no-pull", action="store_true",
                   help="build without forcing a fresh npm install")
    p.set_defaults(func=cmd_build)

    p = sub.add_parser("update", help="rebuild the image with the latest claude/codex "
                                      "and recreate all containers")
    p.add_argument("--no-pull", action="store_true",
                   help="rebuild without forcing a fresh npm install")
    p.set_defaults(func=cmd_update)

    p = sub.add_parser("rm", help="remove a user's container")
    p.add_argument("name")
    p.add_argument("--purge", action="store_true",
                   help="also delete their home volume and project directory")
    p.add_argument("-y", "--yes", action="store_true", help="do not ask")
    p.set_defaults(func=cmd_rm)

    p = sub.add_parser("render", help="re-render compose.users.yml and authorized_keys")
    p.set_defaults(func=cmd_render)

    args = parser.parse_args()
    for var in BANNED_ENV:
        if var in os.environ:
            warn(f"{var} is set in your shell. portal strips it before touching docker, "
                 "but do not put it in any compose file: it breaks Remote Control.")
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
