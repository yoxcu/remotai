# users.yaml — the single source of truth for the agent host.
#
# `portal` reads this file and renders compose.users.yml from it.
# Edit by hand if you like, then run `./portal update` (or `./portal render`)
# to apply. `portal add` / `portal rm` maintain it for you.

# Directory on the host that holds per-user project bind mounts and the
# generated authorized_keys files. Created by `portal add`.
srv_root: /srv/agents

# Hostname used in the Remote Control session name ("<name>@<host>") so you can
# tell this server apart from others in claude.ai/code. Defaults to the host's
# own hostname when unset.
#host: agents.example.com

users:
  - name: alice
    # sshd is published on the host at 0.0.0.0:<port>. Auto-assigned by
    # `portal add` starting at 2201; keep them unique.
    port: 2201
    # Run the supervised `claude remote-control` loop in this container.
    claude: true
    # Allow the Codex desktop app to connect over SSH. Needs no extra process:
    # the app spawns `codex app-server` itself through the login shell.
    codex: true
    # One or more SSH public keys. These become /etc/ssh/authorized_keys.d/dev
    # inside the container, mounted read-only from the host.
    keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyReplaceMe alice@laptop

  - name: bob
    port: 2202
    claude: true
    codex: false
    keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAnotherExampleKey bob@desktop
