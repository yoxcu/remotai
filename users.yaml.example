# users.yaml — who has a container on this agent host.
#
# Each container accepts two sets of keys, concatenated:
#   authorized_keys:  a file on the host, bind-mounted read-only. Normally the
#                     person's own ~/.ssh/authorized_keys, so rotating a key on
#                     the host rotates it in the container.
#   extra_keys:       keys listed here, for machines or people with no account
#                     on this host.
# Either may be omitted, but not both. Both are picked up within ~15s of
# changing (run `./portal render` after editing extra_keys); no restart needed.
#
# `portal` renders compose.users.yml from this file.
# `portal add` / `portal rm` maintain it; hand edits are fine (comments are not
# preserved across those two commands).

# Where per-user project directories live. Created by `portal add`.
srv_root: /srv/agents

# Hostname used in the Remote Control session name ("<name>@<host>") so you can
# tell this server apart from others in claude.ai/code. Defaults to the host's
# own hostname when unset.
#host: agents.example.com

# UID/GID baked into the image, so bind-mounted projects are writable from both
# sides. Defaults to whoever runs portal (SUDO_UID under sudo). Pin it here if
# more than one person runs portal.
#uid: 1000
#gid: 1000

users:
  - name: alice
    # sshd is published on the host at 0.0.0.0:<port>. Auto-assigned by
    # `portal add` starting at 2201; keep them unique.
    port: 2201
    # Run the supervised `claude remote-control` loop in this container.
    claude: true
    # How Remote Control creates sessions:
    #   same-dir  (default) every session shares workdir
    #   worktree            each session gets its own git worktree — REQUIRES
    #                       workdir to be a git repository
    #   session             a single session, capacity 1, exits when complete
    spawn: same-dir
    # Where the server runs. /home/dev/projects holds repos but is not itself
    # one, so point workdir at a repo if you want spawn: worktree.
    workdir: /home/dev/projects
    # Allow the Codex desktop app to connect over SSH. Needs no extra process:
    # the app spawns `codex app-server` itself through the login shell.
    codex: true
    # Resolved by `portal add` from the matching host account. Point it
    # somewhere else if the container name and the host account differ.
    authorized_keys: /home/alice/.ssh/authorized_keys
    # Anything extra, on top of that file.
    extra_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyReplaceMe alice@work-laptop

  - name: bob
    port: 2202
    claude: true
    codex: false
    authorized_keys: /home/bob/.ssh/authorized_keys

  # No host account: extra_keys carries this one on its own.
  - name: ci
    port: 2203
    claude: false
    codex: true
    extra_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyReplaceMe ci@runner
